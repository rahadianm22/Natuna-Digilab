# Copy to .env.local and fill in. Server-only: never prefix with NEXT_PUBLIC_.
# Z.ai key from https://z.ai. glm-4.7-flash and glm-4.5-flash are free.
ZAI_API_KEY=
ZAI_BASE_URL=https://api.z.ai/api/paas/v4
ZAI_MODEL=glm-4.7-flash

# Optional providers. Add a key and that provider joins the fallback chain automatically:
# if a model is overloaded or out of quota, the route tries the next one.
# Provider ids for TANYA_PROVIDERS, in default order:
#   zai:glm-4.7-flash, zai:glm-4.5-flash, nvidia:..., dashscope:..., openrouter:..., deepseek:..., custom:...
# Example: TANYA_PROVIDERS=zai:glm-4.7-flash,nvidia:deepseek-ai/deepseek-v4.1-flash,dashscope:qwen3.8-flash

# NVIDIA hosted NIM (build.nvidia.com): free trial credits, hosts DeepSeek and Qwen.
# Its terms limit the free trial to testing and evaluation, not production.
# NVIDIA_API_KEY=
# TANYA_NVIDIA_MODELS=deepseek-ai/deepseek-v4.1-flash,qwen/qwen3-next-80b-a3b-instruct

# Alibaba Model Studio (Qwen): new Singapore accounts get a free quota per model.
# DASHSCOPE_API_KEY=
# TANYA_DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# TANYA_DASHSCOPE_MODEL=qwen3.8-flash

# OpenRouter: free models rotate. See https://openrouter.ai/models?max_price=0
# OPENROUTER_API_KEY=
# TANYA_OPENROUTER_MODEL=google/gemma-4-31b-it:free

# DeepSeek's own API is paid, so it is last in the chain.
# DEEPSEEK_API_KEY=
# TANYA_DEEPSEEK_MODEL=deepseek-chat

# Any OpenAI-compatible endpoint, such as Xiaomi MiMo or a local model server.
# TANYA_CUSTOM_BASE_URL=
# TANYA_CUSTOM_API_KEY=
# TANYA_CUSTOM_MODEL=
# TANYA_CUSTOM_LABEL=

# Seconds to wait for one provider's response before trying the next. Default 8000.
# TANYA_PROVIDER_TIMEOUT_MS=8000
